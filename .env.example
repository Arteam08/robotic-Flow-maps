# Copy to .env (git-ignored).  Only environment variables are used: nothing is written to ~/.netrc.
# --- wandb (curves + checkpoints).  Leave the key empty to run fully offline.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=robotic-flow-maps
# WANDB_MODE=offline        # force offline even with a key; "disabled" = local files only
# --- Hugging Face weights.  No token needed once the repo is public.
RFM_HF_REPO=EquilibriumMap/robotic-flow-maps-weights            # released weights (read)
RFM_HF_RESULTS_REPO=EquilibriumMap/robotic-flow-maps-results    # your checkpoints go here (write)
HF_TOKEN=                  # fine-grained token we give you: read weights repo, write results repo
