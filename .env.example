# Copy to .env (git-ignored). Only these lines are needed; nothing is written to ~/.netrc or a keychain.
WANDB_API_KEY=            # shared handoff account key (we send it out of band)
WANDB_ENTITY=eqfm-handoff-carnegie-mellon-university
WANDB_PROJECT=robotic-flow-maps
# WANDB_MODE=offline      # force offline even with a key; "disabled" = local files only
RFM_HF_REPO=EquilibriumMap/robotic-flow-maps-weights   # public: released weights, no token needed
# --- optional: checkpoints to Hugging Face instead of wandb artifacts (we send this token if we choose that route)
# HF_TOKEN=                                          # fine-grained token, write on the results repo only
# RFM_HF_RESULTS_REPO=EquilibriumMap/robotic-flow-maps-results
